---
import Base from '../layouts/Base.astro';
import TutorialCard from '../components/TutorialCard.astro';
import { site, categories, roadmap, faq } from '../site.config';
import { getTutorials, url } from '../lib';

const tutorials = await getTutorials();
const usedCategories = categories.filter((c) => tutorials.some((t) => t.data.category === c.key));
const totalMinutes = tutorials.reduce((sum, t) => sum + t.data.duration, 0);
const firstTutorial = tutorials.find((t) => t.data.featured) ?? tutorials[0];

const stats = [
  { value: tutorials.length, label: '篇教程' },
  { value: usedCategories.length, label: '个分类' },
  { value: totalMinutes, label: '分钟学完全部' },
];
---

<Base>
  <!-- ========== Hero ========== -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="chip chip-brand hero-chip">✦ 专为新朋友准备的上手教程</span>
      <h1>
        {site.heroTitle}<br />
        <span class="gradient-text">{site.heroHighlight}</span>
      </h1>
      <p class="hero-desc">{site.description}</p>
      <div class="hero-actions">
        {firstTutorial && (
          <a class="btn btn-primary" href={url(`tutorials/${firstTutorial.id}/`)}>从第一篇开始 →</a>
        )}
        <a class="btn btn-ghost" href="#tutorials">浏览全部教程</a>
      </div>
      <ul class="hero-points">
        <li>✓ 步骤清晰，可直接复制</li>
        <li>✓ 每步都有检查点</li>
        <li>✓ 持续更新</li>
      </ul>
      <div class="stats card">
        {stats.map((s) => (
          <div class="stat">
            <strong class="gradient-text">{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 学习路线 ========== -->
  <section class="section" id="roadmap">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">ROADMAP</span>
        <h2>三步上手，不迷路</h2>
        <p>不知道从哪开始？按这个顺序走就对了。</p>
      </div>
      <ol class="roadmap">
        {roadmap.map((step, i) => (
          <li class="card step">
            <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ========== 教程列表 ========== -->
  <section class="section" id="tutorials">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">TUTORIALS</span>
        <h2>全部教程</h2>
        <p>按分类筛选，或直接搜索你想学的内容。</p>
      </div>

      <div class="toolbar">
        <div class="tabs" role="tablist" aria-label="教程分类">
          <button class="tab active" data-filter="all" role="tab" aria-selected="true">全部</button>
          {usedCategories.map((c) => (
            <button class="tab" data-filter={c.key} role="tab" aria-selected="false" title={c.desc}>
              {c.name}
            </button>
          ))}
        </div>
        <label class="search">
          <span aria-hidden="true">⌕</span>
          <input id="search" type="search" placeholder="搜索教程，如：Git、安装" autocomplete="off" />
        </label>
      </div>

      <div class="grid" id="grid">
        {tutorials.map((t) => <TutorialCard tutorial={t} />)}
      </div>
      <p class="empty" id="empty" hidden>没有找到相关教程，换个关键词试试，或者告诉我你想看什么 👇</p>
    </div>
  </section>

  <!-- ========== 常见问题 ========== -->
  <section class="section" id="faq">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">FAQ</span>
        <h2>常见问题</h2>
      </div>
      <div class="faq">
        {faq.map((item, i) => (
          <details class="card" open={i === 0}>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 联系 ========== -->
  <section class="section" id="contact">
    <div class="container">
      <div class="cta card">
        <div>
          <h2>卡住了？直接来问我</h2>
          <p>带上截图和你已经试过的步骤，我能更快帮你定位问题。</p>
        </div>
        <div class="cta-links">
          {site.contacts.map((c) => (
            <a class="btn btn-ghost" href={c.href} target="_blank" rel="noopener">{c.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const grid = document.getElementById('grid')!;
  const empty = document.getElementById('empty')!;
  const search = document.getElementById('search') as HTMLInputElement;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tcard'));
  let filter = 'all';

  function apply() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const okCat = filter === 'all' || card.dataset.category === filter;
      const okText = !q || q.split(/\s+/).every((w) => card.dataset.keywords!.includes(w));
      const visible = okCat && okText;
      card.hidden = !visible;
      if (visible) shown++;
    }
    empty.hidden = shown > 0;
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      filter = tab.dataset.filter!;
      for (const t of tabs) {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      }
      apply();
    });
  }
  search.addEventListener('input', apply);
</script>

<style>
  /* Hero */
  .hero { padding: 88px 0 40px; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .hero-chip { margin-bottom: 22px; }
  h1 { font-size: clamp(32px, 5.6vw, 56px); line-height: 1.18; letter-spacing: -0.01em; }
  .hero-desc { max-width: 600px; margin-top: 20px; font-size: 16px; color: var(--text-2); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 30px; }
  .hero-points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    margin-top: 22px;
    font-size: 13px;
    color: var(--text-3);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    max-width: 620px;
    margin-top: 48px;
    padding: 20px 8px;
  }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat + .stat { border-left: 1px solid var(--line); }
  .stat strong { font-size: 30px; line-height: 1.2; }
  .stat span { font-size: 13px; color: var(--text-3); }

  /* 学习路线 */
  .roadmap { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .step { padding: 26px 24px; }
  .step-no {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--brand-soft);
    border: 1px solid rgba(109, 94, 252, 0.35);
    color: #c9c3ff;
    font-weight: 700;
    font-family: var(--mono);
    margin-bottom: 16px;
  }
  .step h3 { font-size: 17px; margin-bottom: 6px; }
  .step p { color: var(--text-2); font-size: 14px; }

  /* 教程列表 */
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 30px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 5px; border-radius: 14px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.02); }
  .tab { padding: 7px 14px; border-radius: 10px; font-size: 14px; color: var(--text-2); cursor: pointer; transition: background 0.2s, color 0.2s; }
  .tab:hover { color: var(--text); }
  .tab.active { color: #fff; background: var(--gradient); box-shadow: 0 6px 18px rgba(109, 94, 252, 0.35); }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    width: min(320px, 100%);
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--text-3);
    transition: border-color 0.2s;
  }
  .search:focus-within { border-color: var(--brand); }
  .search input { flex: 1; min-width: 0; color: var(--text); }
  .search input::placeholder { color: var(--text-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; padding-top: 10px; }
  .grid :global([hidden]) { display: none; }
  .empty { text-align: center; color: var(--text-3); padding: 40px 0; }

  /* FAQ */
  .narrow { max-width: 760px; }
  .faq { display: flex; flex-direction: column; gap: 12px; }
  details { padding: 0 22px; transition: border-color 0.2s; }
  details[open] { border-color: rgba(109, 94, 252, 0.35); }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    font-weight: 600;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 20px; color: var(--text-3); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); color: var(--brand-2); }
  details p { color: var(--text-2); padding-bottom: 18px; margin-top: -4px; }

  /* 联系 */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 36px;
    background:
      radial-gradient(500px 200px at 0% 0%, rgba(109, 94, 252, 0.22), transparent 70%),
      radial-gradient(500px 200px at 100% 100%, rgba(34, 211, 238, 0.14), transparent 70%),
      var(--surface);
  }
  .cta h2 { font-size: 24px; }
  .cta p { color: var(--text-2); margin-top: 6px; }
  .cta-links { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 860px) {
    .roadmap { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 24px; }
    .stat strong { font-size: 24px; }
    .search { width: 100%; }
    .cta { padding: 26px 22px; }
  }
</style>
