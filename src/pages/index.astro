---
import Base from '../layouts/Base.astro';
import TutorialCard from '../components/TutorialCard.astro';
import { getSettings, listTutorials } from '../server/content';
import { categoryName, url } from '../lib';

const site = getSettings();
const isAdmin = Astro.locals.user?.role === 'admin';
const tutorials = listTutorials({ includeDrafts: isAdmin });
const published = tutorials.filter((t) => !t.draft);
const usedCategories = site.categories.filter((c) => tutorials.some((t) => t.category === c.key));
const totalMinutes = published.reduce((sum, t) => sum + t.duration, 0);
const firstTutorial = published.find((t) => t.featured) ?? published[0];

const stats = [
  { value: published.length, label: '篇教程' },
  { value: new Set(published.map((t) => t.category)).size, label: '个分类' },
  { value: totalMinutes, label: '分钟学完全部' },
];
---

<Base editable>
  <!-- ========== Hero ========== -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="chip chip-brand hero-chip" data-field="heroBadge" data-placeholder="顶部小标签">{site.heroBadge}</span>
      <h1>
        <span data-field="heroTitle" data-placeholder="大标题第一行">{site.heroTitle}</span><br />
        <span class="gradient-text" data-field="heroHighlight" data-placeholder="渐变高亮的第二行">{site.heroHighlight}</span>
      </h1>
      <p class="hero-desc" data-field="description" data-multiline data-placeholder="一段介绍">{site.description}</p>
      <div class="hero-actions">
        {firstTutorial && (
          <a class="btn btn-primary" href={url(`tutorials/${firstTutorial.slug}/`)}>从第一篇开始 →</a>
        )}
        <a class="btn btn-ghost" href="#tutorials">浏览全部教程</a>
      </div>
      <ul class="hero-points" data-list="heroPoints">
        {site.heroPoints.map((p) => (
          <li data-item>✓ <span data-sub="." data-placeholder="卖点">{p}</span><button type="button" class="x edit-only" data-remove aria-label="删除">×</button></li>
        ))}
        <li class="edit-only"><button type="button" class="edit-btn" data-add-item="heroPoints">＋ 卖点</button></li>
      </ul>
      <template data-template="heroPoints">
        <li data-item>✓ <span data-sub="." data-placeholder="卖点">新卖点</span><button type="button" class="x edit-only" data-remove aria-label="删除">×</button></li>
      </template>
      <div class="stats card">
        {stats.map((s) => (
          <div class="stat">
            <strong class="gradient-text">{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========== 学习路线 ========== -->
  {(site.roadmap.length > 0 || isAdmin) && (
    <section class="section" id="roadmap">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">ROADMAP</span>
          <h2 data-field="roadmapTitle">{site.roadmapTitle}</h2>
          <p data-field="roadmapDesc" data-placeholder="一句说明">{site.roadmapDesc}</p>
        </div>
        <ol class="roadmap" data-list="roadmap">
          {site.roadmap.map((step) => (
            <li class="card step" data-item>
              <span class="step-no" aria-hidden="true"></span>
              <h3 data-sub="title" data-placeholder="步骤标题">{step.title}</h3>
              <p data-sub="desc" data-multiline data-placeholder="步骤说明">{step.desc}</p>
              <button type="button" class="x edit-only" data-remove aria-label="删除这一步">×</button>
            </li>
          ))}
          <li class="step-add edit-only"><button type="button" class="edit-btn" data-add-item="roadmap">＋ 添加一步</button></li>
        </ol>
        <template data-template="roadmap">
          <li class="card step" data-item>
            <span class="step-no" aria-hidden="true"></span>
            <h3 data-sub="title" data-placeholder="步骤标题">新的一步</h3>
            <p data-sub="desc" data-multiline data-placeholder="步骤说明">这一步要做什么。</p>
            <button type="button" class="x edit-only" data-remove aria-label="删除这一步">×</button>
          </li>
        </template>
      </div>
    </section>
  )}

  <!-- ========== 教程列表 ========== -->
  <section class="section" id="tutorials">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">TUTORIALS</span>
        <h2 data-field="tutorialsTitle">{site.tutorialsTitle}</h2>
        <p data-field="tutorialsDesc" data-placeholder="一句说明">{site.tutorialsDesc}</p>
        <p class="edit-only new-tutorial">
          <button type="button" class="edit-btn" id="new-tutorial">＋ 新建教程</button>
          <span>分类、联系方式等在底部工具栏「站点设置」里修改</span>
        </p>
      </div>

      <div class="toolbar">
        <div class="tabs" role="tablist" aria-label="教程分类">
          <button class="tab active" data-filter="all" role="tab" aria-selected="true">全部</button>
          {usedCategories.map((c) => (
            <button class="tab" data-filter={c.key} role="tab" aria-selected="false" title={c.desc}>
              {c.name}
            </button>
          ))}
        </div>
        <label class="search">
          <span aria-hidden="true">⌕</span>
          <input id="search" type="search" placeholder="搜索教程，如：Git、安装" autocomplete="off" />
        </label>
      </div>

      <div class="grid" id="grid">
        {tutorials.map((t) => <TutorialCard tutorial={t} categoryName={categoryName(site, t.category)} />)}
      </div>
      <p class="empty" id="empty" hidden={tutorials.length > 0}>
        {tutorials.length > 0 ? '没有找到相关教程，换个关键词试试，或者告诉我你想看什么 👇' : '还没有教程。'}
      </p>
    </div>
  </section>

  <!-- ========== 常见问题 ========== -->
  {(site.faq.length > 0 || isAdmin) && (
    <section class="section" id="faq">
      <div class="container narrow">
        <div class="section-head">
          <span class="eyebrow">FAQ</span>
          <h2>常见问题</h2>
        </div>
        <div class="faq view-only">
          {site.faq.map((item, i) => (
            <details class="card" open={i === 0}>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
        <div class="faq edit-only" data-list="faq">
          {site.faq.map((item) => (
            <div class="card faq-edit" data-item>
              <p class="faq-q" data-sub="q" data-placeholder="问题">{item.q}</p>
              <p class="faq-a" data-sub="a" data-multiline data-placeholder="回答">{item.a}</p>
              <button type="button" class="x" data-remove aria-label="删除这个问题">×</button>
            </div>
          ))}
          <p><button type="button" class="edit-btn" data-add-item="faq">＋ 添加问题</button></p>
        </div>
        <template data-template="faq">
          <div class="card faq-edit" data-item>
            <p class="faq-q" data-sub="q" data-placeholder="问题">新问题？</p>
            <p class="faq-a" data-sub="a" data-multiline data-placeholder="回答">回答内容。</p>
            <button type="button" class="x" data-remove aria-label="删除这个问题">×</button>
          </div>
        </template>
      </div>
    </section>
  )}

  <!-- ========== 联系 ========== -->
  <section class="section" id="contact">
    <div class="container">
      <div class="cta card">
        <div>
          <h2 data-field="contactTitle">{site.contactTitle}</h2>
          <p data-field="contactDesc" data-multiline data-placeholder="一句说明">{site.contactDesc}</p>
        </div>
        <div class="cta-links">
          {site.contacts.map((c) => (
            <a class="btn btn-ghost" href={c.href} target="_blank" rel="noopener">{c.label}</a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // ---------------- 分类筛选 + 搜索 ----------------
  const grid = document.getElementById('grid')!;
  const empty = document.getElementById('empty')!;
  const search = document.getElementById('search') as HTMLInputElement;
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
  const cards = Array.from(grid.querySelectorAll<HTMLElement>('.tcard'));
  let filter = 'all';

  function apply() {
    if (cards.length === 0) return;
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const okCat = filter === 'all' || card.dataset.category === filter;
      const okText = !q || q.split(/\s+/).every((w) => card.dataset.keywords!.includes(w));
      const visible = okCat && okText;
      card.hidden = !visible;
      if (visible) shown++;
    }
    empty.hidden = shown > 0;
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      filter = tab.dataset.filter!;
      for (const t of tabs) {
        t.classList.toggle('active', t === tab);
        t.setAttribute('aria-selected', String(t === tab));
      }
      apply();
    });
  }
  search.addEventListener('input', apply);
</script>

<script>
  // ---------------- 编辑模式（仅管理员页面会加载工具栏） ----------------
  import { api, markDirty, registerPage, setEditing, siteSettings, textOf, touchSettings } from '../scripts/edit-mode';

  if (document.getElementById('site-settings')) {
    registerPage({
      collect() {
        const s = siteSettings();
        for (const el of document.querySelectorAll<HTMLElement>('[data-field]')) s[el.dataset.field!] = textOf(el);
        for (const list of document.querySelectorAll<HTMLElement>('[data-list]')) {
          s[list.dataset.list!] = Array.from(list.querySelectorAll<HTMLElement>('[data-item]'), (item) => {
            const subs = Array.from(item.querySelectorAll<HTMLElement>('[data-sub]'));
            if (subs.length === 1 && subs[0].dataset.sub === '.') return textOf(subs[0]);
            return Object.fromEntries(subs.map((el) => [el.dataset.sub, textOf(el)]));
          });
        }
        touchSettings();
      },
    });

    document.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const remove = t.closest('[data-remove]');
      if (remove) {
        remove.closest('[data-item]')!.remove();
        markDirty();
        return;
      }
      const key = t.closest<HTMLElement>('[data-add-item]')?.dataset.addItem;
      if (key) {
        const template = document.querySelector<HTMLTemplateElement>(`template[data-template="${key}"]`)!;
        const list = document.querySelector<HTMLElement>(`[data-list="${key}"]`)!;
        // 新条目插在「添加」按钮所在的那一行前面
        let addRow = list.querySelector(`[data-add-item="${key}"]`)!;
        while (addRow.parentElement !== list) addRow = addRow.parentElement!;
        const item = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        list.insertBefore(item, addRow);
        setEditing(true);
        item.querySelector<HTMLElement>('[data-sub]')?.focus();
        markDirty();
        return;
      }
      if (t.closest('#new-tutorial')) {
        try {
          const { slug } = await api('POST', '/api/tutorials');
          location.href = `/tutorials/${slug}/`;
        } catch (err) {
          alert((err as Error).message);
        }
      }
    });
  }
</script>

<style>
  /* Hero */
  .hero { padding: 88px 0 40px; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .hero-chip { margin-bottom: 22px; }
  h1 { font-size: clamp(32px, 5.6vw, 56px); line-height: 1.18; letter-spacing: -0.01em; }
  .hero-desc { max-width: 600px; margin-top: 20px; font-size: 16px; color: var(--text-2); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 30px; }
  .hero-points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    margin-top: 22px;
    font-size: 13px;
    color: var(--text-3);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    max-width: 620px;
    margin-top: 48px;
    padding: 20px 8px;
  }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat + .stat { border-left: 1px solid var(--line); }
  .stat strong { font-size: 30px; line-height: 1.2; }
  .stat span { font-size: 13px; color: var(--text-3); }

  /* 学习路线 */
  .roadmap { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .step { padding: 26px 24px; }
  .roadmap { counter-reset: step; }
  .step { position: relative; counter-increment: step; }
  .step-no::before { content: counter(step, decimal-leading-zero); }
  .step-add { display: grid; place-items: center; border: 1px dashed var(--line-2); border-radius: var(--radius); min-height: 120px; }
  .x {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    font-size: 18px;
    color: var(--text-3);
    cursor: pointer;
  }
  .x:hover { color: var(--danger-text); background: color-mix(in srgb, var(--danger) 10%, transparent); }
  .hero-points .x { position: static; width: 22px; height: 22px; font-size: 15px; margin-left: 2px; }
  .new-tutorial { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px; margin-top: 16px; font-size: 13px; color: var(--text-3); }
  .faq-edit { position: relative; padding: 18px 48px 18px 22px; }
  .faq-q { font-weight: 600; }
  .faq-a { color: var(--text-2); margin-top: 10px; white-space: pre-wrap; }
  .step-no {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--brand-soft);
    border: 1px solid color-mix(in srgb, var(--brand) 35%, transparent);
    color: var(--brand-text);
    font-weight: 700;
    font-family: var(--mono);
    margin-bottom: 16px;
  }
  .step h3 { font-size: 17px; margin-bottom: 6px; }
  .step p { color: var(--text-2); font-size: 14px; }

  /* 教程列表 */
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 30px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; padding: 5px; border-radius: 14px; border: 1px solid var(--line); background: color-mix(in srgb, var(--ink) 2%, transparent); }
  .tab { padding: 7px 14px; border-radius: 10px; font-size: 14px; color: var(--text-2); cursor: pointer; transition: background 0.2s, color 0.2s; }
  .tab:hover { color: var(--text); }
  .tab.active { color: var(--on-brand); background: var(--gradient); box-shadow: 0 6px 18px color-mix(in srgb, var(--brand) 35%, transparent); }
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    width: min(320px, 100%);
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: var(--surface);
    color: var(--text-3);
    transition: border-color 0.2s;
  }
  .search:focus-within { border-color: var(--brand); }
  .search input { flex: 1; min-width: 0; color: var(--text); }
  .search input::placeholder { color: var(--text-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; padding-top: 10px; }
  .grid :global([hidden]) { display: none; }
  .empty { text-align: center; color: var(--text-3); padding: 40px 0; }

  /* FAQ */
  .narrow { max-width: 760px; }
  .faq { display: flex; flex-direction: column; gap: 12px; }
  details { padding: 0 22px; transition: border-color 0.2s; }
  details[open] { border-color: color-mix(in srgb, var(--brand) 35%, transparent); }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 0;
    font-weight: 600;
    cursor: pointer;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-size: 20px; color: var(--text-3); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); color: var(--brand-2); }
  details p { color: var(--text-2); padding-bottom: 18px; margin-top: -4px; }

  /* 联系 */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 36px;
    background:
      radial-gradient(500px 200px at 0% 0%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 70%),
      radial-gradient(500px 200px at 100% 100%, color-mix(in srgb, var(--brand-2) 14%, transparent), transparent 70%),
      var(--surface);
  }
  .cta h2 { font-size: 24px; }
  .cta p { color: var(--text-2); margin-top: 6px; }
  .cta-links { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 860px) {
    .roadmap { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 24px; }
    .stat strong { font-size: 24px; }
    .search { width: 100%; }
    .cta { padding: 26px 22px; }
  }
</style>
