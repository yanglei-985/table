---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LevelChip from '../../components/LevelChip.astro';
import { getTutorials, url, categoryName, formatDate, type Tutorial } from '../../lib';

export async function getStaticPaths() {
  const tutorials = await getTutorials();
  return tutorials.map((tutorial, i) => ({
    params: { id: tutorial.id },
    props: { tutorial, prev: tutorials[i - 1], next: tutorials[i + 1] },
  }));
}

interface Props {
  tutorial: Tutorial;
  prev?: Tutorial;
  next?: Tutorial;
}

const { tutorial, prev, next } = Astro.props;
const { title, description, category, level, duration, tags, updated } = tutorial.data;
const { Content, headings } = await render(tutorial);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={description}>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="container layout">
    <article>
      <nav class="crumbs" aria-label="面包屑">
        <a href={url('')}>首页</a>
        <span>/</span>
        <a href={url('#tutorials')}>{categoryName(category)}</a>
      </nav>

      <header class="head">
        <h1>{title}</h1>
        <p class="desc">{description}</p>
        <div class="meta">
          <LevelChip level={level} />
          <span class="chip">⏱ 约 {duration} 分钟</span>
          <span class="chip">更新于 {formatDate(updated)}</span>
          {tags.map((t) => <span class="chip">#{t}</span>)}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="上一篇 / 下一篇">
        {prev ? (
          <a class="card pager-item" href={url(`tutorials/${prev.id}/`)}>
            <span>← 上一篇</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a class="card pager-item next" href={url(`tutorials/${next.id}/`)}>
            <span>下一篇 →</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <a class="card pager-item next" href={url('#tutorials')}>
            <span>全部学完了 🎉</span>
            <strong>回到教程列表</strong>
          </a>
        )}
      </nav>
    </article>

    {toc.length > 0 && (
      <aside class="toc" aria-label="本文目录">
        <div class="toc-inner card">
          <p class="toc-title">本文目录</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>

<script>
  // 代码块「复制」按钮
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const btn = document.createElement('button');
    btn.className = 'copy';
    btn.type = 'button';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(code.replace(/\n$/, ''));
        btn.textContent = '已复制 ✓';
      } catch {
        btn.textContent = '复制失败';
      }
      setTimeout(() => (btn.textContent = '复制'), 1600);
    });
    pre.appendChild(btn);
  }

  // 阅读进度条 + 目录高亮
  const bar = document.getElementById('progress')!;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const targets = links
    .map((a) => document.getElementById(a.dataset.slug!))
    .filter((el): el is HTMLElement => !!el);

  function onScroll() {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
    let current = targets[0]?.id;
    for (const el of targets) if (el.getBoundingClientRect().top < 120) current = el.id;
    for (const a of links) a.classList.toggle('active', a.dataset.slug === current);
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  article { min-width: 0; max-width: 780px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--text-3); }
  .crumbs a:hover { color: var(--text); }
  .head { padding: 18px 0 30px; border-bottom: 1px solid var(--line); margin-bottom: 30px; }
  h1 { font-size: clamp(28px, 4.2vw, 40px); line-height: 1.25; }
  .desc { color: var(--text-2); font-size: 16px; margin-top: 12px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; }
  .pager-item { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; transition: border-color 0.2s; }
  .pager-item:hover { border-color: color-mix(in srgb, var(--brand) 45%, transparent); }
  .pager-item span { font-size: 13px; color: var(--text-3); }
  .pager-item.next { text-align: right; }

  .toc { position: relative; }
  .toc-inner { position: sticky; top: 88px; padding: 18px; }
  .toc-title { font-size: 12px; letter-spacing: 0.12em; color: var(--text-3); margin-bottom: 10px; }
  .toc ul { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .toc a {
    display: block;
    padding: 5px 10px;
    border-left: 2px solid transparent;
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.5;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc .d3 a { padding-left: 22px; font-size: 12.5px; }
  .toc a:hover { color: var(--text); }
  .toc a.active { color: var(--text); border-left-color: var(--brand); }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .toc { display: none; }
  }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pager-item.next { text-align: left; }
  }

  /* ---------- 正文排版 ---------- */
  .prose { font-size: 16px; line-height: 1.85; color: var(--prose); }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) {
    font-size: 24px;
    line-height: 1.35;
    color: var(--text);
    margin-top: 2.2em;
    padding-top: 0.2em;
  }
  .prose :global(h2::before) {
    content: '';
    display: inline-block;
    width: 6px;
    height: 0.9em;
    margin-right: 10px;
    border-radius: 3px;
    background: var(--gradient);
    vertical-align: -0.06em;
  }
  .prose :global(h3) { font-size: 19px; color: var(--text); margin-top: 1.8em; }
  .prose :global(a) { color: var(--brand-text); border-bottom: 1px solid color-mix(in srgb, var(--brand-text) 35%, transparent); }
  .prose :global(a:hover) { color: var(--text); border-color: var(--text); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 0.35em; }
  .prose :global(li::marker) { color: var(--brand-2); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line-2); margin: 2.4em 0; }
  .prose :global(img) { border-radius: 12px; border: 1px solid var(--line); }
  .prose :global(:not(pre) > code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 0.15em 0.45em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--brand) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand) 25%, transparent);
    color: var(--brand-text);
  }
  .prose :global(pre) {
    position: relative;
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.65;
  }
  .prose :global(pre code) { font-family: inherit; }
  .prose :global(.copy) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-family: var(--font);
    color: var(--text-2);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    border: 1px solid var(--line-2);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, color 0.2s;
  }
  .prose :global(pre:hover .copy),
  .prose :global(.copy:focus-visible) { opacity: 1; }
  .prose :global(.copy:hover) { color: var(--text); }
  @media (hover: none) {
    .prose :global(.copy) { opacity: 1; }
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; display: block; overflow-x: auto; }
  .prose :global(th),
  .prose :global(td) { padding: 10px 14px; border: 1px solid var(--line-2); text-align: left; }
  .prose :global(th) { background: var(--surface-2); color: var(--text); }
  .prose :global(blockquote) {
    padding: 12px 18px;
    border-left: 3px solid var(--line-2);
    color: var(--text-2);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
    border-radius: 0 10px 10px 0;
  }

  /* 提示框：> [!TIP] / [!NOTE] / [!CHECK] / [!WARNING] / [!DANGER] */
  .prose :global(.callout) {
    --c: var(--brand-2);
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
    background: color-mix(in srgb, var(--c) 9%, transparent);
    font-size: 15px;
  }
  .prose :global(.callout > * + *) { margin-top: 0.5em; }
  .prose :global(.callout-title) { font-weight: 700; color: var(--c); }
  .prose :global(.callout-tip) { --c: var(--ok); }
  .prose :global(.callout-note) { --c: var(--brand-2); }
  .prose :global(.callout-check) { --c: var(--ok); }
  .prose :global(.callout-warning) { --c: var(--warn); }
  .prose :global(.callout-danger) { --c: var(--danger); }
  .prose :global(.callout-tip .callout-title::before) { content: '💡 '; }
  .prose :global(.callout-note .callout-title::before) { content: 'ℹ️ '; }
  .prose :global(.callout-check .callout-title::before) { content: '✅ '; }
  .prose :global(.callout-warning .callout-title::before) { content: '⚠️ '; }
  .prose :global(.callout-danger .callout-title::before) { content: '⛔ '; }

  /* 有序列表 = 操作步骤，用圆形数字强调 */
  .prose :global(ol) { list-style: none; padding-left: 0; counter-reset: step; }
  .prose :global(ol > li) { position: relative; padding-left: 40px; counter-increment: step; }
  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
    color: var(--on-brand);
    background: var(--gradient);
  }
</style>
