---
// 教程页：找到这篇教程交给教程部渲染；草稿只有管理员能看
import TutorialPage from '../../parts/tutorials/components/TutorialPage.astro';
import { getTutorial } from '../../parts/tutorials/store';

const tutorial = getTutorial(Astro.params.slug!);
if (!tutorial || (tutorial.draft && Astro.locals.user?.role !== 'admin')) {
  return Astro.rewrite('/404');
}
---

<TutorialPage tutorial={tutorial} />
