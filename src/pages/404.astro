---
import Layout from '../parts/design/Layout.astro';
import { url } from '../core/util';
---

<Layout title="页面不存在">
  <section class="container nf">
    <p class="code gradient-text">404</p>
    <h1>这一页走丢了</h1>
    <p>可能链接写错了，或者教程已经改名。回到首页找找看吧。</p>
    <a class="btn btn-primary" href={url('')}>回到首页</a>
  </section>
</Layout>

<style>
  .nf { text-align: center; padding: 120px 20px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .code { font-size: 88px; font-weight: 800; line-height: 1; }
  .nf p { color: var(--text-2); }
  .nf .btn { margin-top: 10px; }
</style>
