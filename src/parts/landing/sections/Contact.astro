---
// 落地部 · 联系方式：按钮的文字可直接改，点 ⚙ 改链接
import { landing } from '../../index';
import EditableLink from '../../editor/EditableLink.astro';

const page = landing();
const isAdmin = Astro.locals.user?.role === 'admin';
---

<section class="section" id="contact" data-part="landing">
  <div class="container">
    <div class="cta card">
      <div>
        <h2 data-field="contactTitle">{page.contactTitle}</h2>
        <p data-field="contactDesc" data-multiline data-placeholder="一句说明">{page.contactDesc}</p>
      </div>
      <div class="cta-links" data-list="contacts">
        {page.contacts.map((c) => <EditableLink link={c} class="btn btn-ghost" />)}
        {isAdmin && <button type="button" class="edit-btn edit-only add-link" data-add-item="contacts" data-open-link>＋ 联系方式</button>}
      </div>
      {isAdmin && (
        <template data-template="contacts">
          <EditableLink link={{ label: '新联系方式', href: 'https://' }} class="btn btn-ghost" />
        </template>
      )}
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 36px;
    background:
      radial-gradient(500px 200px at 0% 0%, color-mix(in srgb, var(--brand) 22%, transparent), transparent 70%),
      radial-gradient(500px 200px at 100% 100%, color-mix(in srgb, var(--brand-2) 14%, transparent), transparent 70%),
      var(--surface);
  }
  .cta h2 { font-size: 24px; }
  .cta p { color: var(--text-2); margin-top: 6px; }
  .cta-links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  @media (max-width: 640px) {
    .cta { padding: 26px 22px; }
  }
</style>
