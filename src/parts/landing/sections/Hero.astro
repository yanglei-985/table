---
// 落地部 · 首屏：小标签、大标题、介绍、按钮、卖点、统计
import { landing } from '../../index';
import { listTutorials } from '../../tutorials/store';
import EditableLink from '../../editor/EditableLink.astro';

const page = landing();
const isAdmin = Astro.locals.user?.role === 'admin';
const published = listTutorials();
const firstTutorial = published.find((t) => t.featured) ?? published[0];
const first = firstTutorial ? `/tutorials/${firstTutorial.slug}/` : null;
// 还没有教程时，访客看不到「第一篇教程」按钮
const buttons = page.heroButtons.filter((b) => b.href !== '@first' || first || isAdmin);
const stats = [
  published.length,
  new Set(published.map((t) => t.category)).size,
  published.reduce((sum, t) => sum + t.duration, 0),
];
---

<section class="hero" data-part="landing">
  <div class="container hero-inner">
    <span class="chip chip-brand hero-chip" data-field="heroBadge" data-placeholder="顶部小标签">{page.heroBadge}</span>
    <h1>
      <span data-field="heroTitle" data-placeholder="大标题第一行">{page.heroTitle}</span><br />
      <span class="gradient-text" data-field="heroHighlight" data-placeholder="渐变高亮的第二行">{page.heroHighlight}</span>
    </h1>
    <p class="hero-desc" data-field="description" data-multiline data-placeholder="一段介绍">{page.description}</p>
    <div class="hero-actions" data-list="heroButtons">
      {buttons.map((b) => <EditableLink link={b} first={first} />)}
      {isAdmin && <button type="button" class="edit-btn edit-only add-link" data-add-item="heroButtons" data-open-link>＋ 按钮</button>}
    </div>
    {isAdmin && (
      <template data-template="heroButtons">
        <EditableLink link={{ label: '新按钮', href: '#tutorials', style: 'ghost' }} />
      </template>
    )}
    <ul class="hero-points" data-list="heroPoints">
      {page.heroPoints.map((p) => (
        <li data-item>✓ <span data-sub="." data-placeholder="卖点">{p}</span><button type="button" class="x edit-only" data-remove aria-label="删除">×</button></li>
      ))}
      <li class="edit-only"><button type="button" class="edit-btn" data-add-item="heroPoints">＋ 卖点</button></li>
    </ul>
    <template data-template="heroPoints">
      <li data-item>✓ <span data-sub="." data-placeholder="卖点">新卖点</span><button type="button" class="x edit-only" data-remove aria-label="删除">×</button></li>
    </template>
    <div class="stats card" data-list="statLabels">
      {stats.map((value, i) => (
        <div class="stat" data-item>
          <strong class="gradient-text">{value}</strong>
          <span data-sub="." data-placeholder="说明">{page.statLabels[i]}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero { padding: 88px 0 40px; text-align: center; }
  .hero-inner { display: flex; flex-direction: column; align-items: center; }
  .hero-chip { margin-bottom: 22px; }
  h1 { font-size: clamp(32px, 5.6vw, 56px); line-height: 1.18; letter-spacing: -0.01em; }
  .hero-desc { max-width: 600px; margin-top: 20px; font-size: 16px; color: var(--text-2); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px; margin-top: 30px; }
  .hero-points {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 22px;
    margin-top: 22px;
    font-size: 13px;
    color: var(--text-3);
  }
  .hero-points .x { position: static; width: 22px; height: 22px; font-size: 15px; margin-left: 2px; }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    max-width: 620px;
    margin-top: 48px;
    padding: 20px 8px;
  }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .stat + .stat { border-left: 1px solid var(--line); }
  .stat strong { font-size: 30px; line-height: 1.2; }
  .stat span { font-size: 13px; color: var(--text-3); }
  @media (max-width: 640px) {
    .hero { padding: 56px 0 24px; }
    .stat strong { font-size: 24px; }
  }
</style>
