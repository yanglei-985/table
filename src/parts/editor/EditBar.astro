---
// 编辑部 · 管理员专用：页面底部的编辑工具栏 + 「站点设置」对话框 + 链接编辑框
import { allParts } from '../index';
import { listTutorials } from '../tutorials/store';
import { sectionNames } from '../landing/part';
import { safeJson } from '../../core/util';

const published = listTutorials();
const firstTutorial = published.find((t) => t.featured) ?? published[0];
// 链接编辑框里可以直接选的目标
const linkTargets = {
  first: firstTutorial ? `/tutorials/${firstTutorial.slug}/` : null,
  anchors: [
    { label: '第一篇教程（自动）', href: '@first' },
    { label: '首页', href: '/' },
    ...(['tutorials', 'roadmap', 'faq', 'contact'] as const).map((id) => ({ label: `首页 · ${sectionNames[id]}`, href: `#${id}` })),
    { label: '账号中心', href: '/account' },
  ],
  tutorials: published.map((t) => ({ label: t.title, href: `/tutorials/${t.slug}/` })),
};
---

<script type="application/json" id="site-parts" set:html={safeJson(allParts())} />
<script type="application/json" id="link-targets" set:html={safeJson(linkTargets)} />

<div class="editbar" role="toolbar" aria-label="编辑工具栏">
  <button class="eb-toggle" type="button" data-action="toggle" aria-pressed="false">
    <span class="eb-dot" aria-hidden="true"></span>
    <span class="eb-label">编辑模式</span>
  </button>
  <span class="eb-tools">
    <button type="button" data-action="settings">站点设置</button>
    <button type="button" data-action="discard">放弃</button>
    <button type="button" class="eb-save" data-action="save">保存</button>
  </span>
</div>

<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<dialog class="sd" id="settings-dialog" aria-labelledby="sd-title">
  <form method="dialog" class="sd-form">
    <header class="sd-head">
      <h2 id="sd-title">站点设置</h2>
      <button type="button" class="sd-x" data-close aria-label="关闭">×</button>
    </header>

    <div class="sd-body">
      <section class="sd-group">
        <h3>基本信息 <small>设计部</small></h3>
        <label>站名 <input name="name" maxlength="30" required /></label>
        <label>图标文字 <input name="logo" maxlength="6" required /></label>
        <label>作者 <input name="author" maxlength="30" required /></label>
        <label>浏览器标签副标题 <input name="tagline" maxlength="80" /></label>
        <label>页脚说明 <input name="footerNote" maxlength="80" /></label>
      </section>

      <section class="sd-group">
        <h3>教程分类 <small>教程部 · 标识用小写英文，教程靠它归类，已有教程在用的分类不能删除</small></h3>
        <div class="rows" data-rows="categories"></div>
        <button type="button" class="sd-add" data-add="categories">＋ 添加分类</button>
      </section>

      <section class="sd-group">
        <h3>邀请文案 <small>成员部 · 复制邀请时使用，{'{name}'} 是站名，{'{link}'} 是邀请链接</small></h3>
        <textarea name="inviteMessage" rows="3" maxlength="300"></textarea>
      </section>
    </div>

    <footer class="sd-foot">
      <button type="button" class="btn btn-ghost" data-close>取消</button>
      <button type="submit" class="btn btn-primary" value="apply">应用</button>
    </footer>
  </form>
</dialog>

<dialog class="sd ld" id="link-dialog" aria-labelledby="ld-title">
  <form method="dialog" class="sd-form">
    <header class="sd-head">
      <h2 id="ld-title">编辑链接 / 按钮</h2>
      <button type="button" class="sd-x" data-ld-cancel aria-label="关闭">×</button>
    </header>
    <div class="sd-body">
      <section class="sd-group">
        <label>文字 <input name="label" maxlength="30" /></label>
        <label>点击后去哪 <select name="target"></select></label>
        <label class="ld-custom" hidden>网址 <input name="custom" maxlength="300" placeholder="https://… 或 /tutorials/… 或 mailto:…" /></label>
        <label class="ld-style" hidden>样式
          <select name="style">
            <option value="primary">主按钮（渐变色）</option>
            <option value="ghost">次按钮（描边）</option>
          </select>
        </label>
        <p class="ld-error form-error" role="alert"></p>
      </section>
    </div>
    <footer class="sd-foot ld-foot">
      <button type="button" class="btn btn-ghost ld-delete" data-ld-delete>删除</button>
      <span class="ld-spacer"></span>
      <button type="button" class="btn btn-ghost" data-ld-cancel>取消</button>
      <button type="submit" class="btn btn-primary">确定</button>
    </footer>
  </form>
</dialog>

<script>
  import {
    discard,
    hasUnsavedChanges,
    isEditing,
    onToggle,
    save,
    partData,
    setEditing,
    touchPart,
    wantsEditing,
  } from './client/edit-mode';
  import { enableInlineFields } from './client/inline-fields';
  import { setupLinkEditor } from './client/link-editor';

  // 页面上所有带标记的文字、列表、链接都接入编辑（顶栏、页脚、首页各区块……）
  enableInlineFields();
  setupLinkEditor();

  const bar = document.querySelector<HTMLElement>('.editbar')!;
  const toggle = bar.querySelector<HTMLButtonElement>('[data-action="toggle"]')!;
  const saveBtn = bar.querySelector<HTMLButtonElement>('[data-action="save"]')!;
  const toastEl = document.getElementById('toast')!;
  let toastTimer = 0;

  function toast(message: string, tone: 'ok' | 'error' = 'ok') {
    toastEl.textContent = message;
    toastEl.dataset.tone = tone;
    toastEl.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toastEl.hidden = true), tone === 'error' ? 6000 : 2600);
  }

  onToggle((on) => {
    toggle.setAttribute('aria-pressed', String(on));
    toggle.querySelector('.eb-label')!.textContent = on ? '编辑中' : '编辑模式';
  });

  bar.addEventListener('click', async (e) => {
    const action = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-action]')?.dataset.action;
    if (action === 'toggle') {
      if (isEditing() && hasUnsavedChanges()) return discard();
      setEditing(!isEditing());
    } else if (action === 'discard') {
      discard();
    } else if (action === 'settings') {
      openDialog();
    } else if (action === 'save') {
      saveBtn.disabled = true;
      saveBtn.textContent = '保存中…';
      try {
        await save();
      } catch (err) {
        toast((err as Error).message, 'error');
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }
  });

  // Ctrl/Cmd + S 保存
  addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's' && isEditing()) {
      e.preventDefault();
      saveBtn.click();
    }
  });

  // ---------------------------------------------------------- 站点设置对话框
  const dialog = document.getElementById('settings-dialog') as HTMLDialogElement;
  const form = dialog.querySelector('form')!;
  // 对话框里每个字段归哪个部管
  const simple = {
    name: 'design',
    logo: 'design',
    author: 'design',
    tagline: 'design',
    footerNote: 'design',
    inviteMessage: 'accounts',
  } as const;
  const rowOwner = { categories: 'tutorials' } as const;

  const rowTemplates = {
    categories: (r: { key?: string; name?: string; desc?: string } = {}) => `
      <input data-k="key" placeholder="标识，如 tools" maxlength="20" required pattern="[a-z0-9\\-]+" value="${esc(r.key)}" />
      <input data-k="name" placeholder="名称" maxlength="20" required value="${esc(r.name)}" />
      <input data-k="desc" placeholder="一句话说明" maxlength="60" value="${esc(r.desc)}" />`,
  };
  type RowKind = keyof typeof rowTemplates;
  type PartId = Parameters<typeof partData>[0];

  function esc(v = '') {
    return v.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function addRow(kind: RowKind, data?: any) {
    const row = document.createElement('div');
    row.className = `row row-${kind}`;
    row.innerHTML = `${rowTemplates[kind](data)}<button type="button" class="row-x" aria-label="删除这一行">×</button>`;
    dialog.querySelector(`[data-rows="${kind}"]`)!.appendChild(row);
  }

  function openDialog() {
    for (const [k, part] of Object.entries(simple))
      (form.elements.namedItem(k) as HTMLInputElement).value = partData(part)[k] ?? '';
    for (const kind of Object.keys(rowTemplates) as RowKind[]) {
      dialog.querySelector(`[data-rows="${kind}"]`)!.innerHTML = '';
      for (const r of partData(rowOwner[kind])[kind]) addRow(kind, r);
    }
    dialog.showModal();
  }

  dialog.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-close]') || t === dialog) dialog.close();
    const add = t.closest<HTMLElement>('[data-add]')?.dataset.add as RowKind | undefined;
    if (add) addRow(add);
    if (t.closest('.row-x')) t.closest('.row')!.remove();
  });

  form.addEventListener('submit', (e) => {
    const rows = (kind: RowKind) =>
      Array.from(dialog.querySelectorAll(`[data-rows="${kind}"] .row`), (row) =>
        Object.fromEntries(
          Array.from(row.querySelectorAll<HTMLInputElement>('[data-k]'), (i) => [i.dataset.k, i.value.trim()]),
        ),
      );
    if (rows('categories').length === 0) {
      e.preventDefault();
      toast('至少保留一个分类', 'error');
      return;
    }
    // 只标记真正改动过的部
    const changed = (part: PartId, key: string, value: unknown) => {
      if (JSON.stringify(partData(part)[key]) === JSON.stringify(value)) return;
      partData(part)[key] = value;
      touchPart(part);
    };
    for (const [k, part] of Object.entries(simple))
      changed(part, k, (form.elements.namedItem(k) as HTMLInputElement).value.trim());
    for (const kind of Object.keys(rowTemplates) as RowKind[]) changed(rowOwner[kind], kind, rows(kind));
    document.dispatchEvent(new CustomEvent('settings-applied'));
    if (!isEditing()) setEditing(true);
    toast('已应用，点「保存」后生效');
  });

  if (wantsEditing()) setEditing(true);
</script>

<style>
  .editbar {
    position: fixed;
    left: 50%;
    bottom: 20px;
    z-index: 80;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow);
    font-size: 14px;
    max-width: calc(100vw - 24px);
  }
  .editbar button {
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    color: var(--text-2);
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }
  .editbar button:hover { color: var(--text); background: color-mix(in srgb, var(--ink) 6%, transparent); }
  .eb-toggle { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text) !important; }
  .eb-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--text-3); }
  .eb-toggle[aria-pressed='true'] .eb-dot { background: var(--ok); box-shadow: 0 0 0 4px color-mix(in srgb, var(--ok) 25%, transparent); }
  .eb-tools { display: none; align-items: center; gap: 2px; }
  :global(html.editing) .eb-tools { display: inline-flex; }
  .editbar .eb-save { background: var(--gradient); color: var(--on-brand); font-weight: 600; }
  .editbar .eb-save:hover { color: var(--on-brand); background: var(--gradient); filter: brightness(1.08); }
  .editbar .eb-save:disabled { opacity: 0.6; cursor: wait; }
  :global(html.edit-dirty) .eb-save { box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 30%, transparent); }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 76px;
    z-index: 90;
    transform: translateX(-50%);
    max-width: min(520px, calc(100vw - 32px));
    padding: 10px 16px;
    border-radius: 12px;
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    box-shadow: var(--shadow);
    font-size: 14px;
  }
  .toast[data-tone='error'] { color: var(--danger-text); border-color: color-mix(in srgb, var(--danger) 45%, transparent); }

  .sd {
    width: min(640px, calc(100vw - 24px));
    max-height: calc(100vh - 48px);
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .sd::backdrop { background: color-mix(in srgb, var(--shade) 55%, transparent); }
  .sd-form { display: flex; flex-direction: column; max-height: calc(100vh - 48px); }
  .sd-head, .sd-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; }
  .sd-head { border-bottom: 1px solid var(--line); }
  .sd-head h2 { font-size: 18px; }
  .sd-x { font-size: 24px; line-height: 1; color: var(--text-3); cursor: pointer; }
  .sd-body { overflow-y: auto; padding: 8px 20px 4px; }
  .sd-foot { justify-content: flex-end; border-top: 1px solid var(--line); }
  .sd-group { padding: 14px 0; display: grid; gap: 10px; }
  .sd-group + .sd-group { border-top: 1px solid var(--line); }
  .sd-group h3 { font-size: 15px; }
  .sd-group h3 small { display: block; font-weight: 400; color: var(--text-3); font-size: 12px; margin-top: 2px; }
  label { display: grid; grid-template-columns: 120px 1fr; align-items: center; gap: 10px; font-size: 14px; color: var(--text-2); }
  .sd :global(input),
  .sd textarea {
    width: 100%;
    min-width: 0;
    height: 38px;
    padding: 0 12px;
    border-radius: 10px;
    border: 1px solid var(--line-2);
    background: var(--bg);
    color: var(--text);
  }
  .sd textarea { height: auto; padding: 10px 12px; resize: vertical; line-height: 1.6; }
  .sd :global(input:focus),
  .sd textarea:focus { border-color: var(--brand); }
  .sd :global(.row) { display: grid; gap: 8px; align-items: center; }
  .sd :global(.row-categories) { grid-template-columns: 1fr 1fr 2fr 32px; }
  .sd :global(.row-x) { width: 32px; height: 32px; border-radius: 8px; color: var(--text-3); cursor: pointer; font-size: 18px; }
  .sd :global(.row-x:hover) { color: var(--danger-text); background: color-mix(in srgb, var(--danger) 10%, transparent); }
  .sd-add { justify-self: start; padding: 6px 12px; border-radius: 8px; color: var(--brand-text); cursor: pointer; font-size: 14px; }
  .sd-add:hover { background: var(--brand-soft); }
  .rows { display: grid; gap: 8px; }

  .sd :global(select),
  .sd select { width: 100%; height: 38px; padding: 0 10px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--bg); color: var(--text); }
  .ld { width: min(480px, calc(100vw - 24px)); }
  .sd [hidden] { display: none !important; }
  .ld-foot { justify-content: flex-start; }
  .ld-spacer { flex: 1; }
  .ld-delete { color: var(--danger-text); }
  .ld-error { margin: 0; }

  @media (max-width: 560px) {
    label { grid-template-columns: 1fr; gap: 4px; }
    .sd :global(.row-categories) { grid-template-columns: 1fr 1fr 32px; }
    .sd :global(.row-categories [data-k='desc']) { grid-column: 1 / 3; }
    .editbar button { padding: 0 10px; }
  }
</style>
