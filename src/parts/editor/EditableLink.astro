---
// 编辑部 · 可编辑的链接 / 按钮
// 平时就是普通链接；编辑模式下文字可直接改，点 ⚙ 修改链接地址、样式或删除。
// 放在带 data-list 的容器里使用，保存时收集为 { label, href, style? }。
import { isExternal, resolveHref } from '../../core/util';

interface Props {
  link: { label: string; href: string; style?: 'primary' | 'ghost' };
  /** 链接本身的样式类（按钮样式由 style 决定，会附加 btn btn-primary / btn-ghost） */
  class?: string;
  first?: string | null;
  isHome?: boolean;
}

const { link, class: cls = '', first, isHome = true } = Astro.props;
const isAdmin = Astro.locals.user?.role === 'admin';
const href = resolveHref(link.href, { isHome, first });
const styleClass = link.style ? `btn btn-${link.style}` : '';
---

<a
  class:list={[cls, styleClass, 'elink']}
  href={href}
  target={isExternal(href) ? '_blank' : undefined}
  rel={isExternal(href) ? 'noopener' : undefined}
  data-item
  data-v-href={link.href}
  data-v-style={link.style}
><span data-sub="label" data-placeholder="文字">{link.label}</span>{isAdmin && (
    <span class="link-gear edit-only" data-link-edit role="button" tabindex="0" aria-label="修改链接、样式或删除" title="修改链接、样式或删除">⚙</span>
  )}</a>
