---
// 教程部 · 一篇教程的页面：阅读（目录、进度条、复制代码）+ 管理员的编辑器（信息面板、Markdown、实时预览）
// 每篇教程单独渲染，某一篇内容出错只影响它自己。
import Layout from '../../design/Layout.astro';
import LevelChip from './LevelChip.astro';
import { tutorialsConfig } from '../../index';
import { listTutorials, type Tutorial } from '../store';
import { renderTutorial } from '../render';
import { levels } from '../part';
import { url, categoryName, formatDate } from '../../../core/util';

interface Props {
  tutorial: Tutorial;
}

const { tutorial } = Astro.props;
const { categories } = tutorialsConfig();
const isAdmin = Astro.locals.user?.role === 'admin';

const published = listTutorials();
const index = published.findIndex((t) => t.slug === tutorial.slug);
const prev = index > 0 ? published[index - 1] : undefined;
const next = index >= 0 ? published[index + 1] : undefined;

const { slug, title, description, category, level, duration, order, featured, draft, tags, body, updatedAt } = tutorial;
const { html, headings } = await renderTutorial(tutorial);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Layout title={title} description={description} editable>
  <div class="progress" id="progress" aria-hidden="true"></div>

  <div class="container layout">
    <article>
      <nav class="crumbs" aria-label="面包屑">
        <a href={url('')}>首页</a>
        <span>/</span>
        <a href={url('#tutorials')}>{categoryName(categories, category)}</a>
      </nav>

      {draft && <p class="draft-note">这是一篇草稿，只有管理员能看到。在编辑模式里取消勾选「草稿」并保存即可发布。</p>}

      <header class="head">
        <h1 data-edit="title" data-placeholder="教程标题">{title}</h1>
        <p class="desc" data-edit="description" data-multiline data-placeholder="一两句话说明学完能做到什么">{description}</p>
        <div class="meta view-only">
          <LevelChip level={level} />
          <span class="chip">⏱ 约 {duration} 分钟</span>
          <span class="chip">更新于 {formatDate(updatedAt)}</span>
          {tags.map((t) => <span class="chip">#{t}</span>)}
        </div>
      </header>

      {isAdmin && (
        <form class="meta-panel card edit-only" id="meta" onsubmit="return false">
          <label class="field">网址
            <span class="slug"><span>/tutorials/</span><input class="input" name="slug" value={slug} required pattern="[a-z0-9][a-z0-9\-]*" maxlength="60" /></span>
          </label>
          <label class="field">分类
            <select class="input" name="category">
              {categories.map((c) => <option value={c.key} selected={c.key === category}>{c.name}</option>)}
            </select>
          </label>
          <label class="field">难度
            <select class="input" name="level">
              {levels.map((l) => <option selected={l === level}>{l}</option>)}
            </select>
          </label>
          <label class="field">预计时长（分钟）<input class="input" type="number" name="duration" min="1" max="600" value={duration} /></label>
          <label class="field">排序（越小越靠前）<input class="input" type="number" name="order" min="0" max="9999" value={order} /></label>
          <label class="field wide">标签（用逗号分隔）<input class="input" name="tags" value={tags.join('，')} /></label>
          <label class="check"><input type="checkbox" name="featured" checked={featured} /> 显示「新手推荐」角标</label>
          <label class="check"><input type="checkbox" name="draft" checked={draft} /> 草稿（不公开）</label>
          <button type="button" class="edit-btn danger" id="delete-tutorial">删除这篇教程</button>
        </form>
      )}

      <div class="prose view-only" set:html={html} />

      {isAdmin && (
        <section class="editor edit-only" aria-label="正文编辑器">
          <div class="editor-tabs" role="tablist">
            <button type="button" class="active" data-pane="write">编辑</button>
            <button type="button" data-pane="preview">预览</button>
          </div>
          <div class="editor-panes" data-show="write">
            <div class="pane pane-write">
              <textarea id="md" class="input" spellcheck="false" aria-label="正文（Markdown）">{body}</textarea>
              <details class="cheats">
                <summary>写法速查</summary>
                <pre>## 二级标题（会出现在目录里）
1. 有序列表 = 带编号的步骤
`行内代码`   **加粗**   [链接文字](https://…)

```bash
可复制的命令
```

&gt; [!CHECK]
&gt; 检查点（还有 TIP / NOTE / WARNING / DANGER）</pre>
              </details>
            </div>
            <div class="pane pane-preview prose" id="preview" set:html={html} />
          </div>
        </section>
      )}

      <nav class="pager view-only" aria-label="上一篇 / 下一篇">
        {prev ? (
          <a class="card pager-item" href={url(`tutorials/${prev.slug}/`)}>
            <span>← 上一篇</span>
            <strong>{prev.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a class="card pager-item next" href={url(`tutorials/${next.slug}/`)}>
            <span>下一篇 →</span>
            <strong>{next.title}</strong>
          </a>
        ) : (
          <a class="card pager-item next" href={url('#tutorials')}>
            <span>全部学完了 🎉</span>
            <strong>回到教程列表</strong>
          </a>
        )}
      </nav>
    </article>

    {toc.length > 0 && (
      <aside class="toc view-only" aria-label="本文目录">
        <div class="toc-inner card">
          <p class="toc-title">本文目录</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Layout>

<script>
  // 代码块「复制」按钮
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const btn = document.createElement('button');
    btn.className = 'copy';
    btn.type = 'button';
    btn.textContent = '复制';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(code.replace(/\n$/, ''));
        btn.textContent = '已复制 ✓';
      } catch {
        btn.textContent = '复制失败';
      }
      setTimeout(() => (btn.textContent = '复制'), 1600);
    });
    pre.appendChild(btn);
  }

  // 阅读进度条 + 目录高亮
  const bar = document.getElementById('progress')!;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const targets = links
    .map((a) => document.getElementById(a.dataset.slug!))
    .filter((el): el is HTMLElement => !!el);

  function onScroll() {
    const max = document.documentElement.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(scrollY / max, 1) : 0})`;
    let current = targets[0]?.id;
    for (const el of targets) if (el.getBoundingClientRect().top < 120) current = el.id;
    for (const a of links) a.classList.toggle('active', a.dataset.slug === current);
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<script>
  // ---------------- 编辑模式（仅管理员） ----------------
  import { api, clearDirty, markDirty, partData, registerPage, textOf } from '../../editor/client/edit-mode';

  const meta = document.getElementById('meta') as HTMLFormElement | null;
  if (meta && document.getElementById('site-parts')) {
    const originalSlug = location.pathname.split('/').filter(Boolean).pop()!;
    const md = document.getElementById('md') as HTMLTextAreaElement;
    const preview = document.getElementById('preview')!;
    const field = (name: string) => meta.elements.namedItem(name) as HTMLInputElement;

    registerPage({
      async commit() {
        const data = {
          slug: field('slug').value.trim(),
          title: textOf(document.querySelector('[data-edit="title"]')),
          description: textOf(document.querySelector('[data-edit="description"]')),
          category: field('category').value,
          level: field('level').value,
          duration: Number(field('duration').value),
          order: Number(field('order').value),
          tags: field('tags').value.split(/[,，、\s]+/).map((t) => t.trim()).filter(Boolean),
          featured: field('featured').checked,
          draft: field('draft').checked,
          body: md.value,
        };
        const { tutorial } = await api('PUT', `/api/tutorials/${originalSlug}`, data);
        return tutorial.slug !== originalSlug ? `/tutorials/${tutorial.slug}/` : undefined;
      },
    });

    meta.addEventListener('input', markDirty);
    meta.addEventListener('change', markDirty);

    // 实时预览（停止输入 400ms 后刷新）
    let timer = 0;
    let seq = 0;
    md.addEventListener('input', () => {
      markDirty();
      clearTimeout(timer);
      timer = window.setTimeout(async () => {
        const mine = ++seq;
        try {
          const { html } = await api('POST', '/api/preview', { body: md.value });
          if (mine === seq) preview.innerHTML = html;
        } catch (err) {
          preview.textContent = (err as Error).message;
        }
      }, 400);
    });

    // Tab 键插入两个空格而不是跳走
    md.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab' || e.shiftKey) return;
      e.preventDefault();
      document.execCommand('insertText', false, '  ');
    });

    // 窄屏：编辑 / 预览切换
    const panes = document.querySelector<HTMLElement>('.editor-panes')!;
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.editor-tabs button')) {
      btn.addEventListener('click', () => {
        panes.dataset.show = btn.dataset.pane;
        for (const b of document.querySelectorAll('.editor-tabs button')) b.classList.toggle('active', b === btn);
      });
    }

    // 「站点设置」里改了分类后，同步下拉选项
    document.addEventListener('settings-applied', () => {
      const select = field('category') as unknown as HTMLSelectElement;
      const current = select.value;
      select.innerHTML = '';
      for (const c of partData('tutorials').categories) select.add(new Option(c.name, c.key, false, c.key === current));
    });

    document.getElementById('delete-tutorial')!.addEventListener('click', async () => {
      if (!confirm(`确定删除《${textOf(document.querySelector('[data-edit="title"]'))}》？删除后访客将无法访问。`)) return;
      try {
        await api('DELETE', `/api/tutorials/${originalSlug}`);
        clearDirty();
        location.href = '/#tutorials';
      } catch (err) {
        alert((err as Error).message);
      }
    });
  }
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: var(--gradient);
    transform: scaleX(0);
    transform-origin: left;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
  }
  article { min-width: 0; max-width: 780px; }
  .crumbs { display: flex; gap: 8px; font-size: 13px; color: var(--text-3); }
  .crumbs a:hover { color: var(--text); }
  .head { padding: 18px 0 30px; border-bottom: 1px solid var(--line); margin-bottom: 30px; }
  h1 { font-size: clamp(28px, 4.2vw, 40px); line-height: 1.25; }
  .desc { color: var(--text-2); font-size: 16px; margin-top: 12px; }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 56px; }
  .pager-item { display: flex; flex-direction: column; gap: 4px; padding: 18px 20px; transition: border-color 0.2s; }
  .pager-item:hover { border-color: color-mix(in srgb, var(--brand) 45%, transparent); }
  .pager-item span { font-size: 13px; color: var(--text-3); }
  .pager-item.next { text-align: right; }

  .toc { position: relative; }
  .toc-inner { position: sticky; top: 88px; padding: 18px; }
  .toc-title { font-size: 12px; letter-spacing: 0.12em; color: var(--text-3); margin-bottom: 10px; }
  .toc ul { list-style: none; display: flex; flex-direction: column; gap: 2px; }
  .toc a {
    display: block;
    padding: 5px 10px;
    border-left: 2px solid transparent;
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.5;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc .d3 a { padding-left: 22px; font-size: 12.5px; }
  .toc a:hover { color: var(--text); }
  .toc a.active { color: var(--text); border-left-color: var(--brand); }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .toc { display: none; }
  }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr; }
    .pager-item.next { text-align: left; }
  }

  /* ---------- 正文排版 ---------- */
  .prose { font-size: 16px; line-height: 1.85; color: var(--prose); }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) {
    font-size: 24px;
    line-height: 1.35;
    color: var(--text);
    margin-top: 2.2em;
    padding-top: 0.2em;
  }
  .prose :global(h2::before) {
    content: '';
    display: inline-block;
    width: 6px;
    height: 0.9em;
    margin-right: 10px;
    border-radius: 3px;
    background: var(--gradient);
    vertical-align: -0.06em;
  }
  .prose :global(h3) { font-size: 19px; color: var(--text); margin-top: 1.8em; }
  .prose :global(a) { color: var(--brand-text); border-bottom: 1px solid color-mix(in srgb, var(--brand-text) 35%, transparent); }
  .prose :global(a:hover) { color: var(--text); border-color: var(--text); }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 0.35em; }
  .prose :global(li::marker) { color: var(--brand-2); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line-2); margin: 2.4em 0; }
  .prose :global(img) { border-radius: 12px; border: 1px solid var(--line); }
  .prose :global(:not(pre) > code) {
    font-family: var(--mono);
    font-size: 0.88em;
    padding: 0.15em 0.45em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--brand) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--brand) 25%, transparent);
    color: var(--brand-text);
  }
  .prose :global(pre) {
    position: relative;
    padding: 18px 20px;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.65;
  }
  .prose :global(pre code) { font-family: inherit; }
  .prose :global(.copy) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-family: var(--font);
    color: var(--text-2);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
    border: 1px solid var(--line-2);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, color 0.2s;
  }
  .prose :global(pre:hover .copy),
  .prose :global(.copy:focus-visible) { opacity: 1; }
  .prose :global(.copy:hover) { color: var(--text); }
  @media (hover: none) {
    .prose :global(.copy) { opacity: 1; }
  }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; display: block; overflow-x: auto; }
  .prose :global(th),
  .prose :global(td) { padding: 10px 14px; border: 1px solid var(--line-2); text-align: left; }
  .prose :global(th) { background: var(--surface-2); color: var(--text); }
  .prose :global(blockquote) {
    padding: 12px 18px;
    border-left: 3px solid var(--line-2);
    color: var(--text-2);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
    border-radius: 0 10px 10px 0;
  }

  /* 提示框：> [!TIP] / [!NOTE] / [!CHECK] / [!WARNING] / [!DANGER] */
  .prose :global(.callout) {
    --c: var(--brand-2);
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
    background: color-mix(in srgb, var(--c) 9%, transparent);
    font-size: 15px;
  }
  .prose :global(.callout > * + *) { margin-top: 0.5em; }
  .prose :global(.callout-title) { font-weight: 700; color: var(--c); }
  .prose :global(.callout-tip) { --c: var(--ok); }
  .prose :global(.callout-note) { --c: var(--brand-2); }
  .prose :global(.callout-check) { --c: var(--ok); }
  .prose :global(.callout-warning) { --c: var(--warn); }
  .prose :global(.callout-danger) { --c: var(--danger); }
  .prose :global(.callout-tip .callout-title::before) { content: '💡 '; }
  .prose :global(.callout-note .callout-title::before) { content: 'ℹ️ '; }
  .prose :global(.callout-check .callout-title::before) { content: '✅ '; }
  .prose :global(.callout-warning .callout-title::before) { content: '⚠️ '; }
  .prose :global(.callout-danger .callout-title::before) { content: '⛔ '; }

  /* 有序列表 = 操作步骤，用圆形数字强调 */
  .prose :global(ol) { list-style: none; padding-left: 0; counter-reset: step; }
  .prose :global(ol > li) { position: relative; padding-left: 40px; counter-increment: step; }
  .prose :global(ol > li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
    color: var(--on-brand);
    background: var(--gradient);
  }

  /* ---------- 编辑模式 ---------- */
  .draft-note {
    margin-top: 16px;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px dashed var(--line-2);
    color: var(--text-2);
    font-size: 14px;
  }
  .meta-panel {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px 16px;
    align-items: end;
    padding: 20px;
    margin-bottom: 24px;
  }
  .meta-panel .wide { grid-column: span 2; }
  .slug { display: flex; align-items: center; gap: 4px; }
  .slug span { color: var(--text-3); font-family: var(--mono); font-size: 13px; }
  .check { display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-2); height: 42px; }
  .check input { width: 16px; height: 16px; accent-color: var(--brand); }
  .meta-panel .danger { justify-self: start; height: 42px; }
  .editor { display: grid; gap: 10px; }
  .editor-tabs { display: none; gap: 6px; }
  .editor-tabs button { padding: 6px 14px; border-radius: 9px; color: var(--text-2); cursor: pointer; border: 1px solid var(--line-2); }
  .editor-tabs button.active { color: var(--on-brand); background: var(--gradient); border-color: transparent; }
  .editor-panes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start; }
  .pane { min-width: 0; }
  #md {
    min-height: 70vh;
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.7;
    tab-size: 2;
  }
  .pane-preview {
    max-height: calc(70vh + 60px);
    overflow-y: auto;
    padding: 4px 18px 18px;
    border: 1px dashed var(--line-2);
    border-radius: 12px;
  }
  .cheats { margin-top: 8px; font-size: 13px; color: var(--text-3); }
  .cheats summary { cursor: pointer; }
  .cheats pre { margin-top: 8px; padding: 12px; border-radius: 10px; background: var(--surface-2); font-family: var(--mono); white-space: pre-wrap; color: var(--text-2); }
  :global(html.editing) .layout { grid-template-columns: 1fr; }
  :global(html.editing) article { max-width: none; }

  @media (max-width: 860px) {
    .editor-tabs { display: flex; }
    .editor-panes { grid-template-columns: 1fr; }
    .editor-panes[data-show='write'] .pane-preview,
    .editor-panes[data-show='preview'] .pane-write { display: none; }
    .meta-panel .wide { grid-column: auto; }
  }
</style>
