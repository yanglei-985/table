---
// 成员部 · 账号中心：我的账号、修改密码；管理员另有邀请成员、成员列表、网站结构
import QRCode from 'qrcode';
import Layout from '../../design/Layout.astro';
import SiteStructure from './SiteStructure.astro';
import { getDb } from '../../../core/db.mjs';
import { listInvites, inviteStatus } from '../invites.mjs';
import { accounts, design } from '../../index';
import { publicOrigin } from '../../../core/http';
import { formatDate } from '../../../core/util';
import type { User } from '../auth.mjs';

interface Props {
  user: User;
}

const { user } = Astro.props;
const site = { name: design().name, inviteMessage: accounts().inviteMessage };
const isAdmin = user.role === 'admin';
const welcome = Astro.url.searchParams.has('welcome');
const origin = publicOrigin(Astro as any);

interface MemberRow {
  id: number;
  username: string;
  display_name: string;
  role: 'admin' | 'member';
  disabled: number;
  created_at: string;
  last_login_at: string | null;
  inviter: string | null;
}

const members = isAdmin
  ? (getDb()
      .prepare(
        `SELECT u.id, u.username, u.display_name, u.role, u.disabled, u.created_at, u.last_login_at, i.display_name AS inviter
         FROM users u LEFT JOIN users i ON i.id = u.invited_by ORDER BY u.role = 'admin' DESC, u.created_at DESC`,
      )
      .all() as unknown as MemberRow[])
  : [];

const invites = isAdmin
  ? await Promise.all(
      listInvites().map(async (inv) => {
        const link = `${origin}/join/${inv.code}`;
        const status = inviteStatus(inv);
        return {
          ...inv,
          link,
          status,
          message: site.inviteMessage.replaceAll('{name}', site.name).replaceAll('{link}', link),
          qr: status === '有效' ? await QRCode.toString(link, { type: 'svg', margin: 1, width: 160 }) : '',
        };
      }),
    )
  : [];
const activeInvites = invites.filter((i) => i.status === '有效');
const pastInvites = invites.filter((i) => i.status !== '有效');
---

<Layout title="账号中心">
  <section class="container account">
    {welcome && <p class="welcome card">🎉 注册成功，欢迎加入「{site.name}」！从<a href="/#tutorials">教程列表</a>开始吧。</p>}

    <div class="grid-2">
      <div class="card panel">
        <h2>我的账号</h2>
        <dl class="profile">
          <dt>昵称</dt><dd>{user.display_name}</dd>
          <dt>用户名</dt><dd>{user.username}</dd>
          <dt>身份</dt><dd>{isAdmin ? '管理员' : '成员'}</dd>
          <dt>加入时间</dt><dd>{formatDate(user.created_at)}</dd>
        </dl>
        {isAdmin && (
          <p class="hint">在首页或任意教程页，点底部的「编辑模式」即可直接修改网站内容。</p>
        )}
        <button class="btn btn-ghost" id="logout" type="button">退出登录</button>
      </div>

      <form class="card panel" id="password-form">
        <h2>修改密码</h2>
        <label class="field">当前密码<input class="input" type="password" name="current" autocomplete="current-password" required /></label>
        <label class="field">新密码<input class="input" type="password" name="next" autocomplete="new-password" minlength="8" required placeholder="至少 8 位" /></label>
        <p class="form-error" role="alert"></p>
        <button class="btn btn-primary" type="submit">保存新密码</button>
      </form>
    </div>

    {isAdmin && (
      <>
        <div class="card panel" id="invites">
          <div class="panel-head">
            <div>
              <h2>邀请成员</h2>
              <p class="hint">生成邀请链接或二维码发给朋友，对方打开后注册即成为成员。可以发到微信群、朋友圈，让更多人知道。</p>
            </div>
          </div>
          <form class="invite-form" id="invite-form">
            <label class="field">备注（给自己看）<input class="input" name="note" maxlength="60" placeholder="例如：3 月新人班" /></label>
            <label class="field">有效期
              <select class="input" name="expiresInDays">
                <option value="1">1 天</option>
                <option value="7" selected>7 天</option>
                <option value="30">30 天</option>
                <option value="">永久</option>
              </select>
            </label>
            <label class="field">可用次数
              <select class="input" name="maxUses">
                <option value="1">1 人</option>
                <option value="10">10 人</option>
                <option value="50" selected>50 人</option>
                <option value="">不限</option>
              </select>
            </label>
            <button class="btn btn-primary" type="submit">生成邀请链接</button>
          </form>
          <p class="form-error" id="invite-error" role="alert"></p>

          {activeInvites.length === 0 && <p class="empty">还没有可用的邀请链接。</p>}
          <ul class="invites">
            {activeInvites.map((inv) => (
              <li class="invite" data-code={inv.code}>
                <div class="qr" set:html={inv.qr} title="长按或右键保存二维码" />
                <div class="invite-body">
                  <p class="invite-title">
                    <strong>{inv.note || '邀请链接'}</strong>
                    <span class="chip chip-ok">有效</span>
                  </p>
                  <p class="invite-link"><code>{inv.link}</code></p>
                  <p class="invite-meta">
                    已使用 {inv.uses}{inv.max_uses !== null ? ` / ${inv.max_uses}` : ''} 次 ·
                    {inv.expires_at ? ` ${formatDate(inv.expires_at)} 到期` : ' 永久有效'} ·
                    {inv.creator_name ?? '—'} 创建
                  </p>
                  <div class="invite-actions">
                    <button type="button" class="btn btn-ghost sm" data-copy={inv.link}>复制链接</button>
                    <button type="button" class="btn btn-ghost sm" data-copy={inv.message}>复制邀请文案</button>
                    <button type="button" class="btn btn-ghost sm" data-download-qr>下载二维码</button>
                    <button type="button" class="btn btn-ghost sm danger" data-revoke>撤销</button>
                  </div>
                </div>
              </li>
            ))}
          </ul>
          {pastInvites.length > 0 && (
            <details class="past">
              <summary>已失效的邀请（{pastInvites.length}）</summary>
              <ul>
                {pastInvites.map((inv) => (
                  <li>
                    <code>{inv.code}</code> {inv.note} · {inv.status} · 已使用 {inv.uses} 次
                  </li>
                ))}
              </ul>
            </details>
          )}
        </div>

        <SiteStructure />

        <div class="card panel" id="members">
          <h2>成员（{members.length}）</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>昵称</th><th>用户名</th><th>身份</th><th>邀请人</th><th>加入</th><th>最近登录</th><th>状态</th><th></th></tr>
              </thead>
              <tbody>
                {members.map((m) => (
                  <tr data-id={m.id} data-name={m.display_name}>
                    <td>{m.display_name}</td>
                    <td><code>{m.username}</code></td>
                    <td>{m.role === 'admin' ? <span class="chip chip-brand">管理员</span> : '成员'}</td>
                    <td>{m.inviter ?? '—'}</td>
                    <td>{formatDate(m.created_at)}</td>
                    <td>{formatDate(m.last_login_at)}</td>
                    <td>{m.disabled ? <span class="chip chip-danger">已停用</span> : <span class="chip chip-ok">正常</span>}</td>
                    <td>
                      {m.role === 'member' && (
                        <div class="actions">
                          <button type="button" class="link" data-toggle-disabled={m.disabled ? '0' : '1'}>{m.disabled ? '恢复' : '停用'}</button>
                          <button type="button" class="link danger" data-delete-user>删除</button>
                        </div>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </>
    )}
  </section>
</Layout>

<script>
  import { api } from '../../../core/client/api';

  async function run(action: () => Promise<unknown>, reload = true) {
    try {
      await action();
      if (reload) location.reload();
    } catch (err) {
      alert((err as Error).message);
    }
  }

  document.getElementById('logout')!.addEventListener('click', () =>
    run(async () => {
      await api('POST', '/api/auth/logout');
      location.href = '/';
    }, false),
  );

  const pw = document.getElementById('password-form') as HTMLFormElement;
  pw.addEventListener('submit', async (e) => {
    e.preventDefault();
    const error = pw.querySelector('.form-error')!;
    error.textContent = '';
    try {
      await api('POST', '/api/auth/password', Object.fromEntries(new FormData(pw)));
      pw.reset();
      error.textContent = '✓ 密码已修改，其他设备需要重新登录';
    } catch (err) {
      error.textContent = (err as Error).message;
    }
  });

  const inviteForm = document.getElementById('invite-form') as HTMLFormElement | null;
  inviteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = Object.fromEntries(new FormData(inviteForm)) as Record<string, string>;
    try {
      await api('POST', '/api/invites', {
        note: d.note,
        expiresInDays: d.expiresInDays ? Number(d.expiresInDays) : null,
        maxUses: d.maxUses ? Number(d.maxUses) : null,
      });
      location.reload();
    } catch (err) {
      document.getElementById('invite-error')!.textContent = (err as Error).message;
    }
  });

  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const copy = t.closest<HTMLButtonElement>('[data-copy]');
    if (copy) {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy!);
        const label = copy.textContent;
        copy.textContent = '已复制 ✓';
        setTimeout(() => (copy.textContent = label), 1500);
      } catch {
        prompt('复制下面的内容：', copy.dataset.copy);
      }
      return;
    }
    const invite = t.closest<HTMLElement>('.invite');
    if (t.closest('[data-download-qr]') && invite) {
      const svg = invite.querySelector('.qr svg')!.outerHTML;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([svg], { type: 'image/svg+xml' }));
      a.download = `邀请二维码-${invite.dataset.code}.svg`;
      a.click();
      URL.revokeObjectURL(a.href);
      return;
    }
    if (t.closest('[data-revoke]') && invite) {
      if (confirm('撤销后这个链接立即失效，已注册的成员不受影响。确定撤销？'))
        run(() => api('DELETE', `/api/invites/${invite.dataset.code}`));
      return;
    }
    const row = t.closest<HTMLElement>('tr[data-id]');
    if (!row) return;
    const toggle = t.closest<HTMLElement>('[data-toggle-disabled]');
    if (toggle) {
      const disable = toggle.dataset.toggleDisabled === '1';
      if (!disable || confirm(`停用「${row.dataset.name}」？对方会立即退出登录，之后无法登录。`))
        run(() => api('PATCH', `/api/users/${row.dataset.id}`, { disabled: disable }));
    } else if (t.closest('[data-delete-user]')) {
      if (confirm(`永久删除「${row.dataset.name}」的账号？此操作无法撤销。`))
        run(() => api('DELETE', `/api/users/${row.dataset.id}`));
    }
  });
</script>

<style>
  .account { display: grid; gap: 20px; padding-top: 40px; padding-bottom: 40px; }
  .welcome { padding: 16px 20px; border-color: color-mix(in srgb, var(--ok) 40%, transparent); }
  .welcome a { color: var(--brand-text); text-decoration: underline; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .panel { padding: 24px; display: grid; gap: 14px; align-content: start; }
  .panel h2 { font-size: 20px; }
  .hint { font-size: 14px; color: var(--text-3); }
  .profile { display: grid; grid-template-columns: 80px 1fr; gap: 8px 12px; font-size: 15px; }
  .profile dt { color: var(--text-3); }
  #logout { justify-self: start; }
  #password-form .btn { justify-self: start; }

  .invite-form { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 12px; align-items: end; }
  .empty { color: var(--text-3); font-size: 14px; }
  .invites { list-style: none; display: grid; gap: 14px; }
  .invite { display: grid; grid-template-columns: 132px 1fr; gap: 18px; padding: 16px; border: 1px solid var(--line); border-radius: 12px; }
  .qr { background: #fff; border-radius: 10px; padding: 6px; width: 132px; height: 132px; }
  .qr :global(svg) { width: 100%; height: 100%; }
  .invite-body { display: grid; gap: 6px; align-content: start; min-width: 0; }
  .invite-title { display: flex; align-items: center; gap: 10px; }
  .invite-link code { font-family: var(--mono); font-size: 13px; word-break: break-all; color: var(--brand-text); }
  .invite-meta { font-size: 13px; color: var(--text-3); }
  .invite-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .btn.sm { height: 34px; padding: 0 12px; font-size: 13px; }
  .btn.danger, .link.danger { color: var(--danger-text); }
  .past { font-size: 14px; color: var(--text-3); }
  .past summary { cursor: pointer; }
  .past ul { margin: 8px 0 0 18px; }
  .past code { font-family: var(--mono); }

  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; white-space: nowrap; }
  th, td { padding: 10px 12px; border-bottom: 1px solid var(--line); text-align: left; }
  th { color: var(--text-3); font-weight: 600; }
  td code { font-family: var(--mono); font-size: 13px; }
  .actions { display: flex; gap: 10px; }
  .link { color: var(--brand-text); cursor: pointer; font-size: 14px; }
  .link:hover { text-decoration: underline; }

  @media (max-width: 760px) {
    .grid-2 { grid-template-columns: 1fr; }
    .invite-form { grid-template-columns: 1fr 1fr; }
    .invite-form .field:first-child { grid-column: 1 / -1; }
    .invite-form .btn { grid-column: 1 / -1; justify-content: center; }
    .invite { grid-template-columns: 1fr; }
  }
</style>
