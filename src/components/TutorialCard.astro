---
import { url, categoryName, type Tutorial } from '../lib';
import LevelChip from './LevelChip.astro';

interface Props {
  tutorial: Tutorial;
}

const { tutorial } = Astro.props;
const { title, description, category, level, duration, featured, tags } = tutorial.data;
const keywords = [title, description, categoryName(category), level, ...tags].join(' ').toLowerCase();
---

<a
  class:list={['tcard', 'card', { featured }]}
  href={url(`tutorials/${tutorial.id}/`)}
  data-category={category}
  data-keywords={keywords}
>
  {featured && <span class="badge">新手推荐</span>}
  <div class="tcard-top">
    <span class="tcard-cat">{categoryName(category)}</span>
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="tcard-meta">
    <LevelChip level={level} />
    <span class="chip">⏱ 约 {duration} 分钟</span>
    {tags.slice(0, 2).map((t) => <span class="chip">#{t}</span>)}
  </div>
  <span class="tcard-go">开始学习 →</span>
</a>

<style>
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 22px;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .tcard:hover {
    transform: translateY(-3px);
    border-color: rgba(109, 94, 252, 0.45);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(109, 94, 252, 0.15);
  }
  .tcard.featured {
    border-color: rgba(109, 94, 252, 0.4);
    background:
      radial-gradient(420px 160px at 100% 0%, rgba(109, 94, 252, 0.18), transparent 70%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01));
  }
  .badge {
    position: absolute;
    top: -11px;
    right: 18px;
    padding: 3px 11px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    background: var(--gradient);
    box-shadow: 0 6px 16px rgba(109, 94, 252, 0.45);
  }
  .tcard-cat { font-size: 12px; color: var(--brand-2); letter-spacing: 0.06em; }
  h3 { font-size: 18px; line-height: 1.4; }
  p { color: var(--text-2); font-size: 14px; flex: 1; }
  .tcard-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .tcard-go { margin-top: 6px; font-size: 13px; font-weight: 600; color: #c9c3ff; }
  .tcard:hover .tcard-go { color: #fff; }
</style>
