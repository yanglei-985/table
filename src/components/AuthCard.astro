---
// 登录 / 注册页共用的居中卡片
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<section class="container auth">
  <div class="card auth-card">
    <h1>{title}</h1>
    {subtitle && <p class="auth-sub">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .auth { display: grid; place-items: center; padding-top: 72px; padding-bottom: 72px; }
  .auth-card { width: min(420px, 100%); padding: 32px 28px; display: grid; gap: 18px; }
  h1 { font-size: 26px; }
  .auth-sub { color: var(--text-2); margin-top: -8px; }
  .auth-card :global(form) { display: grid; gap: 14px; }
  .auth-card :global(.btn) { justify-content: center; width: 100%; }
  .auth-card :global(.hint) { font-size: 13px; color: var(--text-3); }
</style>
