---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import EditBar from '../components/EditBar.astro';
import { themes, defaultTheme } from '../site.config';
import { getSettings } from '../server/content';
import { url } from '../lib';

interface Props {
  title?: string;
  description?: string;
  /** 管理员在这个页面可以使用编辑模式 */
  editable?: boolean;
}

const site = getSettings();
const user = Astro.locals.user;
const { title, description = site.description, editable = false } = Astro.props;
const showEditBar = editable && user?.role === 'admin';
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`;
const path = Astro.url.pathname;
const themeBg = Object.fromEntries(themes.map((t) => [t.key, t.bg]));
const isHome = path === url('') || path === url('').replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN" data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeBg[defaultTheme]} />
    <!-- 在页面绘制前应用访客上次选择的主题，避免闪烁 -->
    <script is:inline define:vars={{ themeBg }}>
      try {
        const saved = localStorage.getItem('theme');
        if (saved && themeBg[saved]) {
          document.documentElement.dataset.theme = saved;
          document.querySelector('meta[name="theme-color"]').content = themeBg[saved];
        }
      } catch {}
    </script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <a class="brand" href={url('')}>
          <span class="brand-mark">{site.logo}</span>
          <span class="brand-name">{site.name}</span>
        </a>
        <nav class="nav">
          <a href={isHome ? '#tutorials' : url('#tutorials')}>教程</a>
          <a href={isHome ? '#roadmap' : url('#roadmap')}>学习路线</a>
          <a href={isHome ? '#faq' : url('#faq')}>常见问题</a>
          <a class="nav-contact" href={isHome ? '#contact' : url('#contact')}>联系我</a>
          {user ? (
            <a class="nav-cta nav-account" href={url('account')} title="账号中心">
              <span class="avatar" aria-hidden="true">{[...user.display_name][0]}</span>
              <span class="nav-account-name">{user.display_name}</span>
              {user.role === 'admin' && <span class="nav-role">管理员</span>}
            </a>
          ) : (
            <a class="nav-cta" href={`${url('login')}?next=${encodeURIComponent(path)}`}>登录</a>
          )}
        </nav>
        <ThemeSwitcher />
      </div>
    </header>

    <main>
      <slot />
    </main>
    {showEditBar && <EditBar settings={site} />}

    <footer class="footer">
      <div class="container footer-inner">
        <span>© {new Date().getFullYear()} {site.author} · {site.name}</span>
        <span class="footer-note">{site.footerNote}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .topbar-inner { height: 64px; display: flex; align-items: center; gap: 16px; }
  .nav { margin-left: auto; white-space: nowrap; }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; flex-shrink: 0; white-space: nowrap; }
  .brand-mark {
    display: grid;
    place-items: center;
    height: 32px;
    padding: 0 9px;
    border-radius: 10px;
    background: var(--gradient);
    color: var(--on-brand);
    font-size: 13px;
    letter-spacing: 0.04em;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--brand) 40%, transparent);
  }
  .brand-name { font-size: 16px; }
  .nav { display: flex; align-items: center; gap: 4px; font-size: 14px; }
  .nav a { padding: 7px 12px; border-radius: 9px; color: var(--text-2); transition: color 0.2s, background 0.2s; }
  .nav a:hover { color: var(--text); background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .nav .nav-cta { color: var(--text); border: 1px solid var(--line-2); margin-left: 6px; }
  .nav-account { display: inline-flex; align-items: center; gap: 8px; padding-left: 6px !important; }
  .avatar {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--gradient);
    color: var(--on-brand);
    font-size: 12px;
  }
  .nav-role { font-size: 11px; padding: 1px 6px; border-radius: 6px; background: var(--brand-soft); color: var(--brand-text); }
  .footer { border-top: 1px solid var(--line); margin-top: 40px; }
  .footer-inner {
    min-height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 18px;
    padding-bottom: 18px;
    color: var(--text-3);
    font-size: 13px;
  }
  @media (max-width: 640px) {
    .brand-name { display: none; }
    .topbar-inner { gap: 10px; }
    .nav a { padding: 7px 9px; }
    .nav a:nth-child(2),
    .nav a:nth-child(3),
    .nav .nav-contact,
    .nav-account-name,
    .nav-role { display: none; }
  }
</style>
